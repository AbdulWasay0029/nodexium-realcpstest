---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/5 bg-[#05080F]">
  <div class="max-w-6xl w-full mx-auto px-4 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-10">
      
      <!-- Brand Section -->
      <div class="space-y-4">
        <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity w-fit">
          <div class="w-7 h-7 bg-[#00D4FF] rounded-md flex items-center justify-center">
            <svg class="w-4 h-4 text-[#04222B]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
          </div>
          <span class="font-display font-bold text-xl text-white tracking-tight">realcpstest<span class="text-[#00D4FF]">.com</span></span>
        </a>
        <p class="text-xs text-[#A1A1A1] max-w-xs font-medium leading-relaxed">
          The most accurate, ad-free click speed testing suite on the web. Benchmark your performance with zero lag.
        </p>
        <div class="flex items-center gap-2 bg-[#1A2F22] border border-[#2E4A35] rounded-full px-3 py-1 w-fit">
          <span class="w-1.5 h-1.5 bg-[#3FB950] rounded-full shadow-[0_0_8px_#3FB950]"></span>
          <span class="text-[9px] text-[#3FB950] font-mono font-medium tracking-widest uppercase">0 Ads / 100% Free</span>
        </div>
      </div>

      <!-- Tools Column -->
      <div class="space-y-4">
        <h4 class="text-white font-display font-semibold tracking-tight">Our Tools</h4>
        <ul class="space-y-2.5 text-sm font-medium text-[#A1A1A1]">
          <li><a href="/" class="hover:text-[#00D4FF] transition-colors">CPS Test (Mouse)</a></li>
          <li><a href="/spacebar-counter" class="hover:text-[#00D4FF] transition-colors">Spacebar Counter</a></li>
          <li><a href="/kohi-click-test" class="hover:text-[#00D4FF] transition-colors">Kohi Click Test</a></li>
          <li><a href="/jitter-click-test" class="hover:text-[#00D4FF] transition-colors">Jitter Click Test</a></li>
        </ul>
      </div>

      <!-- Socials Column -->
      <div class="space-y-4">
        <h4 class="text-white font-display font-semibold tracking-tight">Socials & Partners</h4>
        <ul class="space-y-2.5 text-sm font-medium text-[#A1A1A1]">
          <li>
            <a href="https://instagram.com/nodexium" target="_blank" rel="noopener noreferrer" class="hover:text-[#00D4FF] transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              Instagram
            </a>
          </li>
          <li>
            <a href="https://youtube.com/@capitalclips.co" target="_blank" rel="noopener noreferrer" class="hover:text-[#00D4FF] transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
              Capital Clips
            </a>
          </li>
          <li>
            <a href="mailto:nodexium@gmail.com" class="hover:text-[#00D4FF] transition-colors flex items-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              nodexium@gmail.com
            </a>
          </li>
        </ul>
      </div>

      <!-- Legal Column -->
      <div class="space-y-4">
        <h4 class="text-white font-display font-semibold tracking-tight">Legal & Info</h4>
        <ul class="space-y-2.5 text-sm font-medium text-[#A1A1A1]">
          <li><a href="/privacy" class="hover:text-[#00D4FF] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-[#00D4FF] transition-colors">Terms of Service</a></li>
          <li><a href="/contact" class="hover:text-[#00D4FF] transition-colors">Contact Us</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[#A1A1A1] font-mono">
        &copy; {currentYear} realcpstest.com. All rights reserved.
      </p>
      <div class="flex items-center gap-1.5">
        <span class="text-[10px] text-[#A1A1A1] font-mono tracking-widest uppercase mr-2">built by</span>
        <span class="text-[#00D4FF] text-xs font-mono font-semibold tracking-wide">nodexium.</span>
      </div>
    </div>
  </div>
</footer>

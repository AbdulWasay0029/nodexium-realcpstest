---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contact Us - Real CPS Test"
  description="Get in touch with the Real CPS Test team. We'd love to hear your feedback, suggestions, or business inquiries."
>
  <div class="glass rounded-3xl p-8 sm:p-12 max-w-3xl mx-auto space-y-8 mt-10 text-center">
    
    <div class="space-y-4 border-b border-white/5 pb-8">
      <div class="w-16 h-16 rounded-2xl bg-[#00D4FF]/10 border border-[#00D4FF]/30 text-[#00D4FF] flex items-center justify-center mx-auto mb-4">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
      </div>
      <h1 class="text-3xl sm:text-5xl font-display font-bold text-white tracking-tight">Get in touch</h1>
      <p class="text-[#A1A1A1] text-sm sm:text-base max-w-md mx-auto">
        Have questions, feedback, or just want to say hi? We'd love to hear from you. Drop us an email and we'll get back to you as soon as possible.
      </p>
    </div>

    <div class="pt-4 space-y-6">
      <a href="mailto:nodexium@gmail.com" class="inline-flex items-center gap-3 bg-[#00D4FF] hover:bg-[#00B8E6] text-[#04222B] font-semibold font-mono px-8 py-4 rounded-xl transition-all active:scale-95 shadow-lg shadow-[#00D4FF]/20">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        nodexium@gmail.com
      </a>
      
      <p class="text-xs text-[#A1A1A1]">
        Typical response time: 24-48 hours.
      </p>
    </div>
    
  </div>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About Us - Real CPS Test" description="Learn about realcpstest.com and Nodexium">
  <div class="max-w-3xl mx-auto space-y-6 py-6">
    <h1 class="text-3xl font-display font-bold text-[#E6EDF3]">About Real CPS Test</h1>
    
    <div class="space-y-4 text-sm text-[#8B949E]">
      <p><strong>realcpstest.com</strong> is a zero-popup, high-precision click speed testing tool built for gamers, students, and digital creators.</p>
      
      <p>Our goal is to provide a clean, lightning-fast, and distraction-free environment to test mouse clicking speed without invasive pop-ups, mandatory email signups, or slow page loads.</p>

      <div class="bg-[#161B22] border border-[#30363D] p-4 rounded-xl mt-4">
        <h2 class="font-mono text-[#E6EDF3] text-sm">Part of the Nodexium Product Suite</h2>
        <p class="text-xs text-[#8B949E] mt-1">Built and maintained by Nodexium — architecting autonomous systems and small digital utilities shipped monthly.</p>
      </div>
    </div>
  </div>
</Layout>
